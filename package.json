{
  "name": "minimal-ai",
  "version": "3.3.1",
  "description": "Privacy-first CLI for running local LLMs \u2014 discover, configure, run, and chat",
  "author": "Eeshan Srivastava (https://eeshans.com)",
  "type": "module",
  "bin": {
    "minimal-ai": "bin/minimal-ai.mjs"
  },
  "files": [
    "bin/*.mjs",
    "src/*.mjs",
    "src/commands/*.mjs",
    "src/autotune/*.mjs",
    "src/profile-setup/*.mjs",
    "src/ui/*.mjs",
    "resources/web-search.json",
    "resources/skills/",
    "CHANGELOG.md",
    "install.sh"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eeshansrivastava89/minimal-ai.git"
  },
  "homepage": "https://github.com/eeshansrivastava89/minimal-ai#readme",
  "bugs": {
    "url": "https://github.com/eeshansrivastava89/minimal-ai/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/minimal-ai.mjs",
    "test": "node scripts/verify-imports.mjs && node scripts/check-changelog.mjs && node --test test/*.mjs",
    "test:integration": "MINIMAL_INTEGRATION=1 node --test test/integration/*.mjs",
    "test:e2e": "python3 scripts/e2e.py",
    "lint": "eslint src/*.mjs src/autotune/*.mjs src/commands/*.mjs scripts/*.mjs bin/*.mjs test/*.mjs",
    "check:privacy": "node scripts/privacy-gate.mjs",
    "release:check": "bash scripts/release-check.sh",
    "release:check:fast": "bash scripts/release-check.sh --skip-install --skip-manual --skip-e2e",
    "prepack": "npm run check:privacy",
    "pretest": "npm run lint",
    "dev": "vite -c src/web/vite.config.ts",
    "build:web": "tsc -b src/web && vite build -c src/web/vite.config.ts",
    "preview:web": "vite preview -c src/web/vite.config.ts",
    "check:hub": "tsc --noEmit -p tsconfig.hub.json"
  },
  "dependencies": {
    "@clack/core": "^1.4.3",
    "@clack/prompts": "^1.5.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "picocolors": "^1.1.0",
    "string-width": "^8.2.2",
    "wrap-ansi": "^10.0.1",
    "yaml": "^2.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.34.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "@playwright/test": "^1.60.0"
  },
  "keywords": [
    "local-llm",
    "llama-cpp",
    "cli",
    "privacy",
    "llm",
    "ai"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
